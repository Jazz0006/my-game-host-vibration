.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 40rpx;
  background: #f3f6f4;
  color: #17201b;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #7b8880;
}

.room-title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 24rpx;
  line-height: 72rpx;
  font-size: 30rpx;
  background: #ffffff;
}

.table-stage {
  position: relative;
  width: 640rpx;
  height: 720rpx;
  margin: 0 auto;
}

.table-stage::after {
  content: "";
  position: absolute;
  left: 58rpx;
  top: 54rpx;
  right: 58rpx;
  bottom: 54rpx;
  border-radius: 94rpx;
  background: #dfe8e1;
  box-shadow: inset 0 0 0 2rpx rgba(56, 75, 62, 0.06);
}

.seat {
  position: absolute;
  z-index: 3;
  box-sizing: border-box;
  width: 120rpx;
  height: 72rpx;
  padding: 10rpx 8rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(27, 48, 35, 0.10);
  text-align: center;
}

.seat-ready {
  box-shadow: 0 0 0 3rpx #5a8f6d, 0 6rpx 20rpx rgba(27, 48, 35, 0.10);
}

.seat-offline {
  opacity: 0.45;
}

.seat-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 23rpx;
  font-weight: 600;
}

.owner-badge {
  font-size: 18rpx;
}

.seat-state {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #77837b;
}

.table-center {
  position: absolute;
  z-index: 4;
  left: 170rpx;
  top: 185rpx;
  width: 300rpx;
  min-height: 330rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 40rpx rgba(36, 53, 42, 0.12);
}

.moderator-card {
  padding: 16rpx 12rpx 20rpx;
  text-align: center;
}

.moderator-role {
  font-size: 31rpx;
  font-weight: 700;
}

.moderator-name {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #617067;
}

.divider {
  height: 1rpx;
  background: #dce4de;
}

.game-list {
  padding-top: 12rpx;
}

.game-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  color: #59665e;
}

.game-selected {
  background: #e7f0ea;
  color: #183e27;
  font-weight: 700;
}

.radio {
  width: 28rpx;
}

.status-line {
  margin: 16rpx 8rpx 20rpx;
  text-align: center;
  font-size: 21rpx;
  color: #77837b;
}

.host-actions {
  display: flex;
  gap: 18rpx;
}

.host-actions button {
  flex: 1;
}

.primary-button,
.ready-button {
  background: #284f36;
  color: #ffffff;
  border-radius: 20rpx;
}

.secondary-button {
  background: #ffffff;
  color: #284f36;
  border-radius: 20rpx;
}

.ready-button {
  margin-top: 18rpx;
  width: 100%;
}

.ready-active {
  background: #4f7e5e;
}

