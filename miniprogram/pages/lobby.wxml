<view class="page">
  <view class="topbar">
    <view>
      <view class="eyebrow">ROOM</view>
      <view class="room-title">房间 {{roomCode || "----"}}</view>
    </view>
    <button class="icon-button" bindtap="onSettingsTap">⚙</button>
  </view>

  <view class="table-stage">
    <view
      class="seat {{item.ready ? 'seat-ready' : ''}} {{item.connected === false ? 'seat-offline' : ''}} {{draggingPlayerId === item.id ? 'seat-dragging' : ''}}"
      style="{{item.style}}"
      wx:for="{{seats}}"
      wx:key="id"
      data-player-id="{{item.id}}"
      bindlongpress="onSeatLongPress"
      catchtouchmove="onSeatTouchMove"
      bindtouchend="onSeatTouchEnd"
    >
      <view class="seat-name">
        {{item.name}}
        <text wx:if="{{item.isOwner}}" class="owner-badge">👑</text>
      </view>
      <view class="seat-state">{{item.ready ? "✓ 已准备" : "未准备"}}</view>
    </view>

    <view class="table-center">
      <view
        class="moderator-card {{dragOverModerator ? 'moderator-drop-target' : ''}} {{draggingModerator ? 'moderator-dragging' : ''}}"
        bindlongpress="onModeratorLongPress"
        catchtouchmove="onModeratorTouchMove"
        bindtouchend="onModeratorTouchEnd"
      >
        <view class="moderator-role">{{moderatorLabel}}</view>
        <view class="moderator-name">{{moderatorName}}</view>
        <view class="moderator-hint" wx:if="{{isOwner && !gameStarted}}">
          {{moderatorName === "自动" ? "长按玩家拖到这里" : "长按主持位拖回桌边"}}
        </view>
      </view>

      <view class="divider"></view>

      <view class="game-list">
        <view class="game-option game-selected">
          <text>{{gameLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="status-line">{{statusLine}}</view>

  <view class="host-actions" wx:if="{{!gameStarted && (isOwner || canControlGame)}}">
    <button
      wx:if="{{isOwner}}"
      class="secondary-button"
      bindtap="onInviteTap"
    >邀请朋友</button>
    <button
      wx:if="{{canControlGame}}"
      class="primary-button"
      bindtap="onStartGameTap"
    >开始游戏</button>
  </view>

  <button
    wx:if="{{!isGameModerator}}"
    class="ready-button {{currentPlayerReady ? 'ready-active' : ''}}"
    bindtap="onReadyTap"
  >
    {{currentPlayerReady ? "✓ 已准备好" : "已准备好"}}
  </button>
</view>