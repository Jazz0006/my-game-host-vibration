.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
  background: #f4f6f4;
  color: #17201b;
}

.title {
  margin-bottom: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #d9dfda;
}

.tab {
  padding: 14rpx 4rpx 16rpx;
  margin-right: 28rpx;
  color: #79847c;
}

.tab-active {
  color: #254b34;
  font-weight: 700;
  border-bottom: 4rpx solid #254b34;
}

.room-meta {
  margin-bottom: 16rpx;
  color: #7b857f;
  font-size: 21rpx;
}

.section {
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.section-title {
  padding: 24rpx 24rpx 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #edf0ed;
}

.member-main {
  min-width: 0;
  flex: 1;
}

.member-name {
  font-size: 25rpx;
  font-weight: 600;
}

.owner-label {
  margin-left: 10rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  background: #e8efe9;
  color: #31533c;
  font-size: 18rpx;
}

.member-meta {
  margin-top: 4rpx;
  color: #8a948d;
  font-size: 20rpx;
}

.member-actions {
  display: flex;
  gap: 8rpx;
}

.member-actions button {
  margin: 0;
}

.read-only-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #eef2ef;
  color: #68746c;
  font-size: 21rpx;
  line-height: 1.55;
}

.footnote {
  margin-top: 24rpx;
  padding: 0 8rpx;
  color: #7b857f;
  font-size: 21rpx;
  line-height: 1.6;
}
