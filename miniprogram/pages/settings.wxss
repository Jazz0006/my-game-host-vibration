.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
  background: #f4f6f4;
  color: #17201b;
}

.title {
  margin-bottom: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #d9dfda;
}

.tab {
  padding: 14rpx 4rpx 16rpx;
  margin-right: 28rpx;
  color: #79847c;
}

.tab-active {
  color: #254b34;
  font-weight: 700;
  border-bottom: 4rpx solid #254b34;
}

.section {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
}

.section-copy {
  margin-top: 14rpx;
  color: #6f7972;
  font-size: 22rpx;
  line-height: 1.65;
}

.footnote {
  margin-top: 24rpx;
  padding: 0 8rpx;
  color: #7b857f;
  font-size: 21rpx;
  line-height: 1.6;
}
