<view class="page">
  <view class="topbar">
    <view>
      <view class="eyebrow">GAME</view>
      <view class="title">{{gameLabel}}</view>
    </view>
    <view class="phase-pill">{{phaseLabel}}</view>
  </view>

  <view class="connection-line" wx:if="{{connectionStatus}}">
    {{connectionStatus}}
  </view>

  <view class="role-card" wx:if="{{!isSpectator}}">
    <view class="eyebrow">YOUR ROLE</view>
    <view class="role-name">{{roleName || "等待身份信息"}}</view>
    <view class="role-category" wx:if="{{roleCategory}}">
      {{roleCategory}}
    </view>
    <view class="confirmed-badge" wx:if="{{roleConfirmed}}">
      ✓ 已确认
    </view>
  </view>

  <view class="storyteller-card" wx:if="{{isSpectator}}">
    <view class="eyebrow">STORYTELLER</view>
    <view class="storyteller-title">你是本局说书人</view>
    <view class="storyteller-copy">
      你不参与角色分配。请根据 authoritative ModeratorView 主持当前阶段。
    </view>
    <view class="night-step" wx:if="{{moderatorStepId}}">
      <view>当前夜间步骤：{{moderatorStepId}}</view>
      <view wx:if="{{moderatorActorNames}}">行动玩家：{{moderatorActorNames}}</view>
    </view>
  </view>

  <view class="night-choice-card" wx:if="{{redHerringOptions.length}}">
    <view class="eyebrow">STORYTELLER SETUP</view>
    <view class="choice-title">选择占卜师的红鲱鱼</view>
    <view class="choice-note">必须选择 1 名实际善良玩家；占卜师不会看到这项设置。</view>
    <view class="choice-grid">
      <button
        wx:for="{{redHerringOptions}}"
        wx:key="id"
        class="choice-option {{item.selected ? 'selected' : ''}}"
        data-player-id="{{item.id}}"
        bindtap="onRedHerringTap"
      >
        {{item.name}}
      </button>
    </view>
    <button
      class="primary-button"
      disabled="{{!canSetRedHerring}}"
      bindtap="onSetRedHerringTap"
    >
      确认红鲱鱼
    </button>
  </view>

  <view class="night-card wake" wx:if="{{isNightWake}}">
    <view class="eyebrow">WAKE</view>
    <view class="night-title">请睁眼</view>
    <view class="night-copy" wx:if="{{nightStepId}}">
      当前步骤：{{nightStepId}}
    </view>
  </view>

  <view class="night-card waiting" wx:if="{{isNightWaiting}}">
    <view class="eyebrow">WAIT</view>
    <view class="night-title">请闭眼等待</view>
    <view class="night-copy">轮到你时手机会震动并显示私密信息。</view>
  </view>

  <view class="night-choice-card" wx:if="{{nightChoiceOptions.length}}">
    <view class="eyebrow">NIGHT CHOICE</view>
    <view class="choice-title">请选择玩家</view>
    <view class="choice-note">
      需要选择 {{nightChoiceMinTargets}}–{{nightChoiceMaxTargets}} 人
    </view>
    <view class="choice-grid">
      <button
        wx:for="{{nightChoiceOptions}}"
        wx:key="id"
        class="choice-option {{item.selected ? 'selected' : ''}}"
        data-player-id="{{item.id}}"
        bindtap="onNightChoiceTap"
      >
        {{item.name}}
      </button>
    </view>
    <button
      class="primary-button"
      disabled="{{!canSubmitNightChoice}}"
      bindtap="onSubmitNightChoiceTap"
    >
      确认选择
    </button>
  </view>

  <view class="private-info-card" wx:if="{{minionDemonName}}">
    <view class="eyebrow">MINION INFO</view>
    <view class="private-info-line">恶魔：{{minionDemonName}}</view>
    <view class="private-info-line" wx:if="{{fellowMinionNames}}">
      其他爪牙：{{fellowMinionNames}}
    </view>
  </view>

  <view class="private-info-card" wx:if="{{demonMinionNames || demonBluffNames}}">
    <view class="eyebrow">DEMON INFO</view>
    <view class="private-info-line" wx:if="{{demonMinionNames}}">
      爪牙：{{demonMinionNames}}
    </view>
    <view class="private-info-line" wx:if="{{demonBluffNames}}">
      三个伪装身份：{{demonBluffNames}}
    </view>
  </view>

  <view class="private-info-card" wx:if="{{privateInformationRoleName || privateInformationZeroLabel || hasPrivateInformationNumber || privateInformationBooleanLabel}}">
    <view class="eyebrow">PRIVATE INFO</view>
    <view class="private-info-line" wx:if="{{privateInformationRoleName}}">
      {{privateInformationPlayerNames}} 中有 1 人是 {{privateInformationRoleName}}
    </view>
    <view class="private-info-line" wx:if="{{privateInformationZeroLabel}}">
      {{privateInformationZeroLabel}}
    </view>
    <view class="private-info-line" wx:if="{{hasPrivateInformationNumber}}">
      你得知的数字是 {{privateInformationNumber}}
    </view>
    <view class="private-info-line" wx:if="{{privateInformationBooleanLabel}}">
      占卜结果：{{privateInformationBooleanLabel}}
    </view>
    <button
      wx:if="{{canAcknowledgeNightInformation}}"
      class="primary-button"
      bindtap="onAcknowledgeNightInformationTap"
    >
      我记住这条信息了
    </button>
  </view>

  <view class="progress-card">
    <view class="progress-label">身份确认进度</view>
    <view class="progress-value">{{confirmedRoles}} / {{playerCount}}</view>
    <view class="progress-note" wx:if="{{allConfirmed}}">
      所有玩家已确认
    </view>
  </view>

  <view class="status-line">{{statusLine}}</view>

  <button
    wx:if="{{canConfirmRole}}"
    class="primary-button"
    bindtap="onConfirmRoleTap"
  >
    我知道自己的身份了
  </button>

  <button
    wx:if="{{canBeginFirstNight}}"
    class="primary-button"
    bindtap="onBeginFirstNightTap"
  >
    开始首夜
  </button>

  <button
    wx:if="{{canCommitNightInformation}}"
    class="primary-button"
    bindtap="onCommitNightInformationTap"
  >
    提交当前私密信息
  </button>

  <button
    wx:if="{{canCompleteNightStep}}"
    class="secondary-button"
    bindtap="onCompleteNightStepTap"
  >
    完成当前夜间步骤
  </button>

  <view class="privacy-note" wx:if="{{!isSpectator}}">
    本页只显示服务器为当前玩家生成的 authoritative PlayerView。
  </view>
</view>
