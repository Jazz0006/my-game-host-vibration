<view class="page">
  <view class="hero">
    <view class="brand-mark">桌</view>
    <view class="title">{{productName}}</view>
    <view class="subtitle">一起玩桌游，更轻松</view>
  </view>

  <view class="main-card">
    <button class="create-button" bindtap="onCreateRoomTap">创建房间</button>

    <view class="join-label">加入房间</view>
    <view class="join-row">
      <input
        class="room-input"
        type="number"
        maxlength="4"
        value="{{roomCode}}"
        bindinput="onRoomCodeInput"
        placeholder="4 位房间号"
      />
      <button class="join-button" bindtap="onJoinRoomTap">加入</button>
    </view>

    <button
      wx:if="{{hasRecoverableRoom}}"
      class="continue-button"
      bindtap="onContinueRoomTap"
    >
      继续上次房间
    </button>
  </view>

  <view class="developer-card">
    <view class="developer-title">开发阶段快捷入口</view>
    <view class="developer-copy">
      UI Preview 使用本地展示数据；Diagnostics 保留 E3.7 真机 lifecycle 验证。
    </view>
    <button class="preview-button" bindtap="onPreviewLobbyTap">预览方桌大厅</button>
    <button class="diagnostics-button" bindtap="onOpenDiagnosticsTap">E3.7 Diagnostics</button>
  </view>
</view>
