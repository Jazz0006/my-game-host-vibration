{
  "name": "gamehostsystem",
  "version": "1.0.0",
  "description": "Android-first in-person Werewolf game host using private vibration prompts",
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "prepare:wechat-device": "npm run build:client && node scripts/prepare-wechat-device.mjs",
    "e3:revision": "node scripts/set-e3-device-revision.mjs",
    "predev": "npm run build:client",
    "dev": "tsx watch src/timedServer.ts",
    "prestart": "npm run build:client",
    "start": "tsx src/timedServer.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "verify:flow": "node scripts/verify-flow.mjs",
    "simulate": "node scripts/simulate-game.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
